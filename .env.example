# Taiga API Configuration
# Copy this to .env and set your Taiga backend URL

# For local development with taiga-back running locally:
VITE_API_URL=http://localhost:8000/api/v1

# For production (your Taiga server):
# VITE_API_URL=https://taiga.yourserver.com/api/v1

# ---------------------------------------------------------------------------
# OAuth Configuration
# ---------------------------------------------------------------------------
# Sign in with LinkedTrust (the team OIDC provider — brokers Google + Bluesky).
# This is the primary login. Each deployment registers its own confidential
# client in the IdP's oidc_clients table; the redirect_uri is derived from the
# site origin ({origin}/oauth/callback), so only these two vars differ per site.
#   marten.linkedtrust.us and help.raisethevoices.org each get their own client_id.
PUBLIC_LINKEDTRUST_URL=https://live.linkedtrust.us
PUBLIC_LINKEDTRUST_CLIENT_ID=your_linkedtrust_client_id_here

# Google OAuth - get this from Google Cloud Console > APIs & Services > Credentials
# For SvelteKit, PUBLIC_ prefix exposes the var to the browser via $env/static/public
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------------------------------------------------------------------------
# Volunteer-Friendly Role Defaults
# ---------------------------------------------------------------------------