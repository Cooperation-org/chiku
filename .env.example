# Taiga API Configuration
# Copy this to .env and set your Taiga backend URL

# For local development with taiga-back running locally:
VITE_API_URL=http://localhost:8000/api/v1

# For production (your Taiga server):
# VITE_API_URL=https://taiga.yourserver.com/api/v1

# ---------------------------------------------------------------------------
# OAuth Configuration
# ---------------------------------------------------------------------------
# Google OAuth - get this from Google Cloud Console > APIs & Services > Credentials
# Must be prefixed with VITE_ to be accessible in the browser via import.meta.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------------------------------------------------------------------------
# Volunteer-Friendly Role Defaults
# ---------------------------------------------------------------------------
# When adding/inviting members, Marten will prefer these roles (in order).
# Set this for a volunteer-friendly instance where roles like "Volunteer",
# "Member", "Contributor" are preferred over tech-focused roles like "UX",
# "Product", "Infrastructure".
#
# Comma-separated list; Marten picks the first match found in the project's
# available roles. Falls back to the first role by order if none match.
#
# Volunteer instance:
# VITE_DEFAULT_ROLE_NAMES=Volunteer,Member,Contributor
#
# Leave unset (or empty) to use Taiga's default order behavior — this keeps
# existing tech-oriented instances working without any changes.
